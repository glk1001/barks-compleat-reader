#:import reader_palette barks_reader.core.reader_palette

# The shared scroll-pane look. Behaviour and bar width live on the Python classes
# (barks_kivy_ui.scrolling); this rule only adds the active theme's colours, read
# lazily at widget build. It matches subclasses too (e.g. MenuDropDown). Constructor
# kwargs beat this rule, so a site must not pass bar colours it wants themed.
<ReaderScrollView,ReaderDropDown>:
    bar_color: reader_palette.theme().scrollbar
    bar_inactive_color: reader_palette.theme().scrollbar_inactive

<TouchExpandedButton>:
    opacity: 1 if self.is_active else 0
    disabled: not self.is_active
    background_color: (0, 0, 0, 0)
    background_normal: ""

    # Calculate total size (Visual + Padding)
    size_hint: None, None
    size: self.visual_size + (self.touch_padding * 2), self.visual_size + (self.touch_padding * 2)

    canvas.before:
        Color:
            rgba: .1, .1, .1, 1
        BoxShadow:
            inset: False
            # We use 'root' here to be safe, though 'self' works too.
            # If visual_size is ever 0, this math is now safe.
            pos: self.center_x - (self.visual_size / 2.0), self.center_y - (self.visual_size / 2.0)
            size: self.visual_size, self.visual_size
            offset: 0, 0
            spread_radius: 4, 4
            border_radius: 50, 50, 50, 50
            blur_radius: 3

    Image:
        source: root.source
        color: (1, 1, 1, 1)
        size_hint: None, None
        size: root.visual_size, root.visual_size
        center_x: root.center_x
        center_y: root.center_y
        fit_mode: "contain"
        mipmap: True
