#:import reader_palette barks_reader.core.reader_palette

<_SearchResultButton>:
    background_normal: ''
    background_down: ''
    border: [0, 0, 0, 0]
    background_color:
        reader_palette.theme().accent_selection \
        if (self.selected or self.state != 'normal') \
        else (reader_palette.theme().row_stripe_even if self.row_index % 2 == 0 \
        else reader_palette.theme().row_stripe_odd)
    color:
        reader_palette.theme().text_secondary if self.is_cover \
        else reader_palette.theme().text_title
    italic: self.is_cover
    size_hint_y: None
    height: dp(28)
    halign: 'left'
    valign: 'middle'
    text_size: self.width, self.height
    # A row is one line: a long title is cut short before its issue and year at the
    # right, and a long word or name (Flintheart Glomgold in the word list on a page
    # of the spread) is cut short too, where it wrapped into the row beneath.
    shorten: True
    shorten_from: 'right'
    font_size: fm.search_result_font_size
    padding: [dp(8), 0, (self.detail_width + dp(20)) if self.detail else dp(8), 0]
    Label:
        text: root.detail
        font_size: 0.8 * fm.search_result_font_size
        italic: True
        color: reader_palette.theme().text_secondary
        size_hint: None, None
        size: self.texture_size[0], root.height
        pos: root.right - self.width - dp(8), root.y
        on_texture_size: root.detail_width = self.texture_size[0]

# A row's + is one character in a narrow button: never cut short, or it is a dot.
<_PlusButton>:
    shorten: False

# What a typed query tells the user (a word left out, a syntax error) and the
# headings over its suggestions: rows of the word list that wrap and take no focus.
<_NoticeLabel>:
    size_hint_y: None
    text_size: self.width, None
    height: max(dp(28), self.texture_size[1] + dp(8))
    halign: 'left'
    valign: 'middle'
    padding: [dp(8), dp(4)]
    italic: True
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_secondary
    disabled_color: reader_palette.theme().text_secondary

# A search box's syntax help, shown in its empty results panel while the box is
# empty: what to type, and beside it what that does.
<_SyntaxExample>:
    size_hint: 0.5, None
    text_size: self.width, None
    height: self.texture_size[1] + dp(6)
    halign: 'left'
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_title

<_SyntaxMeaning>:
    size_hint: 0.5, None
    text_size: self.width, None
    height: self.texture_size[1] + dp(6)
    halign: 'left'
    italic: True
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_secondary

<SearchSyntaxHelp>:
    orientation: 'vertical'
    size_hint: 0.95, None
    height: self.minimum_height
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
    spacing: dp(10)

    Label:
        text: root.heading
        italic: True
        font_size: fm.search_label_font_size
        color: reader_palette.theme().text_secondary
        size_hint_y: None
        text_size: self.width, None
        height: self.texture_size[1]
        halign: 'left'

    # A faint card round the examples, so they read as things to type, apart from
    # the heading and the prompts.
    GridLayout:
        id: examples_grid
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(8), 0
        padding: dp(10), dp(8)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.06
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(8)]
            Color:
                rgba: 1, 1, 1, 0.18
            SmoothLine:
                rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
                width: dp(1)

    Label:
        text: root.note
        italic: True
        font_size: fm.search_label_font_size
        color: reader_palette.theme().text_secondary
        size_hint_y: None
        text_size: self.width, None
        height: self.texture_size[1] if root.note else 0
        opacity: 1 if root.note else 0
        halign: 'left'

<_TagChipButton>:
    size_hint: 1, None
    # A tag longer than the chip wraps onto more lines rather than spilling
    # past the pill ("Uncle Scrooge not in US series" at the 35% panel width).
    # Only a chip that fills the row wraps to it; one sized to its text
    # (size_hint_x None, like the speaker chips) must not, or width and text
    # would chase each other down to one letter per line.
    text_size: (self.width - dp(24), None) if self.size_hint_x else (None, None)
    # With a count at the right, the name keeps clear of it: padding on that side only
    # (inside text_size), so the name still has the chip's width to wrap in.
    # A subgroup's arrow sits left of the count, so its name keeps clear of that too.
    padding: [0, 0, (dp(34) if self.count_text else 0) + (dp(16) if self.is_group else 0), 0]
    halign: 'center'
    valign: 'middle'
    height: max(dp(26), self.texture_size[1] + dp(8))
    font_size: fm.search_tag_chip_font_size
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: reader_palette.theme().text_secondary
    canvas.before:
        Color:
            rgba: self.chip_bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        Color:
            rgba: self.chip_border_color
        SmoothLine:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1.5)
    # The stories the tag lists, small at the right (empty on a speaker chip).
    Label:
        text: root.count_text
        font_size: root.font_size * 0.8
        color: root.color[:3] + [0.7]
        size_hint: None, None
        size: self.texture_size
        pos: root.right - self.width - dp(14), root.center_y - self.height / 2
        # A group's arrow, left of the count: pointing on to its members while they
        # are closed, down while they are listed under it; none on a plain tag.
        canvas.before:
            Color:
                rgba: root.color[:3] + [0.8 if root.is_group else 0]
            Triangle:
                points:
                    [self.x - dp(15), self.center_y + dp(3), \
                    self.x - dp(5), self.center_y + dp(3), \
                    self.x - dp(10), self.center_y - dp(4)] \
                    if root.is_open else \
                    [self.x - dp(14), self.center_y + dp(5), \
                    self.x - dp(14), self.center_y - dp(5), \
                    self.x - dp(7), self.center_y]

# A speaker-filter chip on the word search: sized to its name, not to a share
# of the row, so a short row does not stretch "All" across the panel.
<_SpeakerChipButton>:
    size_hint_x: None
    width: self.texture_size[0] + dp(24)

# The speaker filter's chip: its arrow drawn, not typed (the font has no arrow glyph),
# in room kept for it at the right.
<_SaidByChipButton>:
    padding: [dp(14), 0, dp(32), 0]
    width: self.texture_size[0]
    canvas.after:
        Color:
            rgba: self.color
        Triangle:
            points:
                [self.right - dp(26), self.center_y + dp(3), \
                self.right - dp(14), self.center_y + dp(3), \
                self.right - dp(20), self.center_y - dp(4)]

# A row of the speaker filter's list: who, and at the right the stories they say it in.
<_SaidByItem>:
    height: dp(34)
    padding: [dp(12), 0]
    # Opaque under the row's stripe, which is see-through: the list floats over the results.
    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.count_text
        font_size: root.font_size * 0.85
        color: root.color[:3] + [0.7]
        size_hint: None, None
        size: self.texture_size
        pos: root.right - self.width - dp(12), root.center_y - self.height / 2

<SearchModeContent>:
    opacity: 1 if self.shown else 0
    size_hint: (0.86, 1) if self.shown else (0, 0)
    pos_hint: {'center_x': 0.5, 'y': 0}
    padding: [dp(40), dp(30), dp(40), dp(35)]
    spacing: dp(12)
