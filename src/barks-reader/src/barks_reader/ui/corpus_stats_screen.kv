<CorpusStatsScreen>:
    opacity: 1 if root.is_visible else 0
    size_hint: (1, 1) if root.is_visible else (0, 0)

    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ReaderScrollView:
        id: corpus_stats_scroll
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}

        GridLayout:
            id: corpus_stats_rows
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            padding: dp(18), dp(12)
            spacing: dp(2)
