<DocumentReaderScreen>:
    pos_hint: {"center_x": 0.5, "center_y": 0.5}
    # Two pages and the main screen's gutter across on the spread, paired from the first
    # (core.display_unit), so the pages land where the main screen's do; one otherwise.
    pages_wide: root.SPREAD_WIDTH_IN_PAGES if root.layout_mode == 'spread' else 1

    # Shared skeleton (ui/action_bar.kv). Close sits alone behind the fence, as in the
    # comic reader, so an overshoot on Go to Story can't close the document.
    ReaderActionBar:
        id: doc_action_bar
        pos_hint: {"center_x": 0.5, 'top': 1}
        size_hint: None, None
        height: root.ACTION_BAR_HEIGHT
        # As wide as the page box: a page, or the pair on the spread (decision 14).
        width: doc_page.width
        icon_source: root.app_icon_filepath
        title_text: root.action_bar_title

        # The comic reader's button and behaviour: fullscreen hides the bar.
        ChromeFullscreenBarButton:
            id: fullscreen_button
            on_press: root.toggle_screen_mode()

        # The goto-title glyph, as a story is what it goes to; the comic reader's
        # curved arrow is its Goto Page.
        ChromeBarButton:
            id: goto_story_button
            text: "Go to Story"
            icon: str(sys_paths.get_barks_reader_goto_title_icon_file())
            important: True
            # Greyed, not disabled: Kivy's disabled state drops an icon button's icon.
            opacity: 1.0 if root.has_story_links else root.GREYED_BUTTON_OPACITY
            on_release: root.open_goto_story_from_bar()

        QuitFence:

        ChromeBarButton:
            id: close_button
            text: "Close"
            icon: str(sys_paths.get_barks_reader_close_icon_file())
            important: True
            on_press: root.close()

    BoxLayout:
        id: doc_page
        orientation: "vertical"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        size_hint: None,None
        # The pages at the height under the bar, unless the window is too narrow for them.
        width: min(root.pages_wide * (root.height - doc_action_bar.height) / root.ASPECT_RATIO, root.width)
        height: self.width / root.pages_wide * root.ASPECT_RATIO + doc_action_bar.height
        # Add padding to the top to make space for the ActionBar.
        padding: [dp(0), doc_action_bar.height, dp(0), dp(0)]

        BoxLayout:
            id: pages
            orientation: "horizontal"
            # The gutter between a pair; a lone page has none.
            spacing: doc_page.width / root.pages_wide * root.GUTTER_FRACTION if root.right_page_source else 0

            # Explicit widths, never a size hint of 0: a box layout keeps a child's own
            # width for a falsy hint, and Kivy's default is 100 px. A lone page takes the
            # whole box and "contain" centres it.
            Image:
                id: page_image
                size_hint_x: None
                width: (pages.width - pages.spacing) / 2 if root.right_page_source else pages.width
                color: 1,1,1,1
                opacity: 1
                source: root.page_source
                fit_mode: "contain"
                mipmap: True

            Image:
                id: right_page_image
                size_hint_x: None
                width: (pages.width - pages.spacing) / 2 if root.right_page_source else 0
                opacity: 1 if root.right_page_source else 0
                color: 1,1,1,1
                source: root.right_page_source
                fit_mode: "contain"
                mipmap: True
