#:import reader_palette barks_reader.core.reader_palette
#:import search_help barks_reader.core.search_help

<_SearchResultButton>:
    background_normal: ''
    background_down: ''
    border: [0, 0, 0, 0]
    background_color:
        reader_palette.theme().accent_selection \
        if (self.selected or self.state != 'normal') \
        else (reader_palette.theme().row_stripe_even if self.row_index % 2 == 0 \
        else reader_palette.theme().row_stripe_odd)
    color: reader_palette.theme().text_title
    size_hint_y: None
    height: dp(28)
    halign: 'left'
    valign: 'middle'
    text_size: self.width, self.height
    font_size: fm.search_result_font_size
    padding: [dp(8), 0]

# What a typed query tells the user (a word left out, a syntax error) and the
# headings over its suggestions: rows of the word list that wrap and take no focus.
<_NoticeLabel>:
    size_hint_y: None
    text_size: self.width, None
    height: max(dp(28), self.texture_size[1] + dp(8))
    halign: 'left'
    valign: 'middle'
    padding: [dp(8), dp(4)]
    italic: True
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_secondary
    disabled_color: reader_palette.theme().text_secondary

# A search box's syntax help, shown in its empty results panel while the box is
# empty: what to type, and beside it what that does.
<_SyntaxExample>:
    size_hint: 0.5, None
    text_size: self.width, None
    height: self.texture_size[1] + dp(6)
    halign: 'left'
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_title

<_SyntaxMeaning>:
    size_hint: 0.5, None
    text_size: self.width, None
    height: self.texture_size[1] + dp(6)
    halign: 'left'
    italic: True
    font_size: fm.search_result_font_size
    color: reader_palette.theme().text_secondary

<SearchSyntaxHelp>:
    orientation: 'vertical'
    size_hint: 0.95, None
    height: self.minimum_height
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
    spacing: dp(10)

    Label:
        text: root.heading
        italic: True
        font_size: fm.search_label_font_size
        color: reader_palette.theme().text_secondary
        size_hint_y: None
        text_size: self.width, None
        height: self.texture_size[1]
        halign: 'left'

    # A faint card round the examples, so they read as things to type, apart from
    # the heading and the prompts.
    GridLayout:
        id: examples_grid
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(8), 0
        padding: dp(10), dp(8)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.06
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(8)]
            Color:
                rgba: 1, 1, 1, 0.18
            SmoothLine:
                rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
                width: dp(1)

<_TagChipButton>:
    size_hint: 1, None
    # A tag longer than the chip wraps onto more lines rather than spilling
    # past the pill ("Uncle Scrooge not in US series" at the 35% panel width).
    # Only a chip that fills the row wraps to it; one sized to its text
    # (size_hint_x None, like the speaker chips) must not, or width and text
    # would chase each other down to one letter per line.
    text_size: (self.width - dp(24), None) if self.size_hint_x else (None, None)
    # With a count at the right, the name keeps clear of it: padding on that side only
    # (inside text_size), so the name still has the chip's width to wrap in.
    padding: [0, 0, dp(34), 0] if self.count_text else [0, 0, 0, 0]
    halign: 'center'
    valign: 'middle'
    height: max(dp(26), self.texture_size[1] + dp(8))
    font_size: fm.search_tag_chip_font_size
    background_normal: ''
    background_down: ''
    background_color: (0, 0, 0, 0)
    color: reader_palette.theme().text_secondary
    canvas.before:
        Color:
            rgba: self.chip_bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        Color:
            rgba: self.chip_border_color
        SmoothLine:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1.5)
    # The stories the tag lists, small at the right (empty on a speaker chip).
    Label:
        text: root.count_text
        font_size: root.font_size * 0.8
        color: root.color[:3] + [0.7]
        size_hint: None, None
        size: self.texture_size
        pos: root.right - self.width - dp(14), root.center_y - self.height / 2

# A speaker-filter chip on the word search: sized to its name, not to a share
# of the row, so a short row does not stretch "All" across the panel.
<_SpeakerChipButton>:
    size_hint_x: None
    width: self.texture_size[0] + dp(24)

# The speaker filter's chip: its arrow drawn, not typed (the font has no arrow glyph),
# in room kept for it at the right.
<_SaidByChipButton>:
    padding: [dp(14), 0, dp(32), 0]
    width: self.texture_size[0]
    canvas.after:
        Color:
            rgba: self.color
        Triangle:
            points:
                [self.right - dp(26), self.center_y + dp(3), \
                self.right - dp(14), self.center_y + dp(3), \
                self.right - dp(20), self.center_y - dp(4)]

# A row of the speaker filter's list: who, and at the right the stories they say it in.
<_SaidByItem>:
    height: dp(34)
    padding: [dp(12), 0]
    # Opaque under the row's stripe, which is see-through: the list floats over the results.
    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.count_text
        font_size: root.font_size * 0.85
        color: root.color[:3] + [0.7]
        size_hint: None, None
        size: self.texture_size
        pos: root.right - self.width - dp(12), root.center_y - self.height / 2

<SearchInput@TouchAwareTextInput>:
    multiline: False
    # Enter must not blur the input when there is nothing to focus; the
    # on_text_validate handler blurs explicitly when it does move focus.
    text_validate_unfocus: False
    font_size: fm.search_input_font_size
    foreground_color: (1, 1, 1, 1)
    hint_text_color: (1, 1, 1, 0.4)
    background_color: (0.08, 0.08, 0.08, 0.82)
    cursor_color: reader_palette.theme().focus_ring
    cursor_width: dp(2)
    padding: [dp(12), (self.height - self.line_height) / 2]

<SearchClearButton@Button>:
    text: "×"
    bold: True
    font_size: fm.search_clear_button_font_size
    size_hint_x: None
    width: dp(44)
    background_normal: ''
    background_down: ''
    background_color: (0.18, 0.18, 0.18, 0.9)

# A translucent rounded panel that frames a list area, so the screen layout
# reads as designed even before any search results exist.
<SearchPanel@FloatLayout>:
    canvas.before:
        Color:
            rgba: 0.04, 0.04, 0.04, 0.6
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<SearchEmptyPrompt@Label>:
    italic: True
    font_size: fm.search_label_font_size
    color: reader_palette.theme().text_secondary
    halign: 'center'
    valign: 'middle'
    text_size: self.width - dp(40), None
    size_hint: 1, 1
    pos_hint: {'x': 0, 'y': 0}

<SearchScreen>:
    opacity: 1 if root.is_visible else 0
    size_hint: (1, 1) if root.is_visible else (0, 0)

    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}

        Image:
            texture: root.image_texture
            fit_mode: "cover"
            opacity: 0.35
            mipmap: True

        GotoTitleOverlay:
            current_title_str: root.current_title_str
            show_title: root.show_current_title
            on_arrow_press: root.on_goto_background_title()

        # ---- Title Search Content ----
        BoxLayout:
            id: title_search_content
            orientation: 'horizontal'
            size_hint: 0.86, 1
            pos_hint: {'center_x': 0.5, 'y': 0}
            padding: [dp(40), dp(30), dp(40), dp(35)]
            spacing: dp(12)

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.35
                spacing: dp(8)

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(2)

                    SearchInput:
                        id: title_search_input
                        hint_text: "Search titles…"
                        on_text: root.on_title_search_text(self.text)
                        on_text_validate: root.on_search_input_enter()
                        on_focus: root.on_search_input_focus(self, self.focus)

                    SearchClearButton:
                        id: title_clear_button
                        on_release: root.on_title_clear()

                Widget:

            SearchPanel:
                size_hint_x: 0.65

                BoxLayout:
                    size_hint: 1, 1
                    pos_hint: {'x': 0, 'y': 0}
                    padding: dp(8)

                    ReaderScrollView:
                        id: title_results_scroll

                        BoxLayout:
                            id: title_results_layout
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(1)

                SearchEmptyPrompt:
                    text: "Matching story titles will appear here"
                    opacity: 0 if title_results_layout.children else 0.75

        # ---- Tag Search Content ----
        BoxLayout:
            id: tag_search_content
            orientation: 'horizontal'
            size_hint: 0, 0
            opacity: 0
            pos_hint: {'center_x': 0.5, 'y': 0}
            padding: [dp(40), dp(30), dp(40), dp(35)]
            spacing: dp(12)

            # Wider than the other modes' lists: a tag's name, its count and its + share a row,
            # and the stories on the right are titles, which shorten when they must.
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.4
                spacing: dp(8)

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(2)

                    SearchInput:
                        id: tag_search_input
                        hint_text: "Search tags…"
                        on_text: root.on_tag_search_text(self.text)
                        on_text_validate: root.on_search_input_enter()
                        on_focus: root.on_search_input_focus(self, self.focus)

                    SearchClearButton:
                        id: tag_clear_button
                        on_release: root.on_tag_clear()

                # The tags picked with a tag's +, each included or left out, and ALL/ANY:
                # no height (and no gap above the tag list) while nothing is picked.
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(8) if tag_basket_layout.children else 0

                    StackLayout:
                        id: tag_basket_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    SearchPanel:

                        BoxLayout:
                            size_hint: 1, 1
                            pos_hint: {'x': 0, 'y': 0}
                            padding: dp(8)

                            ReaderScrollView:
                                id: tag_chips_scroll

                                # Clear of the scroll bar on the right: the bar can be
                                # dragged, so a tap on a + beneath it scrolled the list.
                                BoxLayout:
                                    id: tag_chips_layout
                                    orientation: 'vertical'
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(4)
                                    padding: [0, 0, tag_chips_scroll.bar_width + dp(4), 0]

                        SearchEmptyPrompt:
                            text: "Matching tags will appear here"
                            opacity: 0 if tag_chips_layout.children else 0.75

            SearchPanel:
                size_hint_x: 0.6

                BoxLayout:
                    orientation: 'vertical'
                    size_hint: 1, 1
                    pos_hint: {'x': 0, 'y': 0}
                    padding: dp(8)
                    spacing: dp(6)

                    # The era the stories are listed from: shared with the word search.
                    StackLayout:
                        id: tag_era_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    # The prompt centres in the list's own space, below the era chips:
                    # over the whole panel it fell on the chips when they filled its top.
                    FloatLayout:

                        ReaderScrollView:
                            id: tag_results_scroll
                            size_hint: 1, 1
                            pos_hint: {'x': 0, 'y': 0}

                            BoxLayout:
                                id: tag_title_results_layout
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: dp(1)

                        SearchEmptyPrompt:
                            text: "Pick a tag to list its stories"
                            opacity:
                                0 if tag_title_results_layout.children \
                                or not tag_search_input.text else 0.75

                        SearchSyntaxHelp:
                            heading: search_help.TAG_HELP_HEADING
                            examples: search_help.TAG_HELP
                            opacity:
                                0 if tag_title_results_layout.children \
                                or tag_search_input.text else 1

        # ---- Word Search Content ----
        BoxLayout:
            id: word_search_content
            orientation: 'horizontal'
            size_hint: 0, 0
            opacity: 0
            pos_hint: {'center_x': 0.5, 'y': 0}
            padding: [dp(40), dp(30), dp(40), dp(35)]
            spacing: dp(12)

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.35
                spacing: dp(8)

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(2)

                    SearchInput:
                        id: word_search_input
                        hint_text: "Search words…"
                        on_text: root.on_word_search_text(self.text)
                        on_text_validate: root.on_search_input_enter()
                        on_focus: root.on_search_input_focus(self, self.focus)

                    SearchClearButton:
                        id: word_clear_button
                        on_release: root.on_word_clear()

                # The words picked with a word's +, and ALL/ANY: no height (and no gap
                # above the word list) while nothing is picked.
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(8) if word_basket_layout.children else 0

                    StackLayout:
                        id: word_basket_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    SearchPanel:

                        BoxLayout:
                            size_hint: 1, 1
                            pos_hint: {'x': 0, 'y': 0}
                            padding: dp(8)

                            ReaderScrollView:
                                id: word_chips_scroll

                                # Clear of the scroll bar on the right: the bar can be
                                # dragged, so a tap on a + beneath it scrolled the list.
                                BoxLayout:
                                    id: word_chips_layout
                                    orientation: 'vertical'
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(1)
                                    padding: [0, 0, word_chips_scroll.bar_width + dp(4), 0]

                        SearchEmptyPrompt:
                            text: "Matching words will appear here"
                            opacity: 0 if word_chips_layout.children else 0.75

            SearchPanel:
                size_hint_x: 0.65

                BoxLayout:
                    orientation: 'vertical'
                    size_hint: 1, 1
                    pos_hint: {'x': 0, 'y': 0}
                    padding: dp(8)
                    spacing: dp(6)

                    # The era the stories are listed from: shared with the tag search.
                    StackLayout:
                        id: word_era_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    # Who-said-it filter, under the era: one chip, which opens the list of the
                    # speakers who say what was searched. Empty (and zero height)
                    # while nothing is searched, or on an index with no speakers.
                    StackLayout:
                        id: speaker_chips_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    # Everywhere, or only in the stories of the tags the tag search has
                    # selected: no height while it has none.
                    StackLayout:
                        id: word_scope_layout
                        orientation: 'lr-tb'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 0
                        spacing: dp(6), dp(4)

                    # The prompt centres in the list's own space, below the chips: over
                    # the whole panel it fell on the era chips when they filled its top.
                    FloatLayout:

                        ReaderScrollView:
                            id: word_results_scroll
                            size_hint: 1, 1
                            pos_hint: {'x': 0, 'y': 0}

                            # Clear of the scroll bar on the right, as the word list is:
                            # each row ends in its speech-bubble button, which the bar
                            # half covered, and a click there grabbed the bar instead.
                            BoxLayout:
                                id: word_results_layout
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: dp(1)
                                padding: [0, 0, word_results_scroll.bar_width + dp(4), 0]

                        SearchEmptyPrompt:
                            text: "Pick a word to see where it is spoken"
                            opacity:
                                0 if word_results_layout.children \
                                or not word_search_input.text else 0.75

                        SearchSyntaxHelp:
                            heading: search_help.WORD_HELP_HEADING
                            examples: search_help.WORD_HELP
                            opacity:
                                0 if word_results_layout.children \
                                or word_search_input.text else 1
