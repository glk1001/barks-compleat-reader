#:import reader_palette barks_reader.core.reader_palette

<ReaderTreeView>:
    hide_root: True
    indent_level: root.TREE_VIEW_INDENT_LEVEL
    size_hint: (1, None)
    # Its height follows minimum_height, which the TreeView's layout sums from its rows:
    # bound that way in ReaderTreeBuilder, never the other way round here.

<ButtonTreeViewNode>:
    color: root.TEXT_COLOR
    color_selected: reader_palette.theme().accent_selection
    background_color: root.BACKGROUND_COLOR
    size_hint: (None, None)
    halign: "left"
    valign: "middle"
    text_size: (self.width, self.height)

<MainTreeViewNode>:
    font_size: fm.tree_view_main_node_font_size
    bold: True
    size: root.NODE_SIZE

<StoryGroupTreeViewNode>:
    font_size: fm.tree_view_story_node_font_size
    markup: True
    height: root.NODE_HEIGHT
    width: root.NODE_WIDTH

<YearRangeTreeViewNode>:
    font_size: fm.tree_view_year_range_node_font_size
    markup: True
    height: root.NODE_HEIGHT
    width: root.NODE_WIDTH

<TreeViewRowNode@BoxLayout>:
    orientation: "horizontal"
    spacing: 0

<IntroTextTreeViewNode>:
    orientation: "vertical"
    size_hint: (None, None)
    width: root.NODE_WIDTH
    height: intro_label.height

    HyphenatingLabel:
        id: intro_label
        source_text: root.source_text
        font_size: fm.tree_view_playlist_intro_font_size
        color: reader_palette.theme().text_secondary
        multiline: True
        markup: True
        mipmap: True
        size_hint: (None, None)
        width: root.NODE_WIDTH
        height: self.texture_size[1]
        text_size: (self.width, None)
        halign: "justify"

<ReadStateDot>:
    size_hint: (None, None)
    canvas:
        Color:
            rgba: reader_palette.theme().text_secondary if self.state != "unread" else (0, 0, 0, 0)
        Line:
            circle: (self.center_x, self.center_y, self.DOT_RADIUS)
            width: dp(1)
        # The whole disc for a finished story, its left half for a part-read one.
        Ellipse:
            pos: (self.center_x - self.DOT_RADIUS, self.center_y - self.DOT_RADIUS)
            size: (2 * self.DOT_RADIUS, 2 * self.DOT_RADIUS)
            angle_start: 0 if self.state == "finished" else 180
            angle_end: 360

<TitleTreeViewNode>:
    orientation: "vertical"
    color: root.TEXT_COLOR
    color_selected: reader_palette.theme().accent_selection
    background_color: root.BACKGROUND_COLOR
    even_color: list(reader_palette.theme().row_stripe_even)
    odd_color: list(reader_palette.theme().row_stripe_odd)
    spacing: 0
    size_hint_y: None
    height: dp(2 * self.ROW_HEIGHT)
    minimum_height: self.height
    minimum_width: self.width

    TreeViewRowNode:
        TreeViewButton:
            id: num_label
            node: root
            font_size: fm.tree_view_num_label_font_size
            color: root.NUM_LABEL_COLOR
            background_color: root.ROW_BACKGROUND_COLOR
            color_selected: reader_palette.theme().accent_selection
            bg_color: list(reader_palette.theme().text_title[:3]) + [0.5]
            bold: True
            size_hint: (None, None)
            width: root.NUM_LABEL_WIDTH
            height: root.ROW_HEIGHT
            halign: "right"
            valign: "middle"
            text_size: (self.width, self.height)

        TitleTreeViewLabel:
            text: ""
            node: root
            font_size: fm.tree_view_num_label_font_size
            color: root.NUM_LABEL_COLOR
            background_color: root.ROW_BACKGROUND_COLOR
            size_hint: (None, None)
            width: dp(10)
            height: root.ROW_HEIGHT
            halign: "right"
            valign: "middle"
            text_size: (self.width, self.height)

        TitleTreeViewLabel:
            id: title_label
            node: root
            font_size: fm.tree_view_title_label_font_size
            color: reader_palette.theme().text_title
            background_color: root.ROW_BACKGROUND_COLOR
            bold: True
            mipmap: True
            size_hint: (None, None)
            width: root.TITLE_LABEL_WIDTH
            height: root.ROW_HEIGHT
            halign: "left"
            valign: "middle"
            text_size: (self.width, self.height)

        # The tree makes the row as wide as itself, so what is left after the title
        # pushes the read mark to the tree's right edge, in one column at every depth.
        Widget:
            size_hint: (1, None)
            height: root.ROW_HEIGHT

        ReadStateDot:
            id: read_dot
            state: root.read_state
            width: root.READ_DOT_WIDTH
            height: root.ROW_HEIGHT

        # Clear of the scrollbar, which lies over the tree's right edge.
        Widget:
            size_hint: (None, None)
            width: root.READ_DOT_RIGHT_MARGIN
            height: root.ROW_HEIGHT

    TreeViewRowNode:
        TitleTreeViewLabel:
            text: "   "
            node: root
            color: root.NUM_LABEL_COLOR
            background_color: root.ROW_BACKGROUND_COLOR
            size_hint: (None, None)
            width: root.NUM_LABEL_WIDTH
            height: root.ROW_HEIGHT
            halign: "right"
            valign: "middle"
            text_size: (self.width, self.height)

        TitleTreeViewLabel:
            text: ""
            node: root
            color: root.NUM_LABEL_COLOR
            background_color: root.ROW_BACKGROUND_COLOR
            size_hint: (None, None)
            width: dp(10)
            height: root.ROW_HEIGHT
            halign: "right"
            valign: "middle"
            text_size: (self.width, self.height)

        TitleTreeViewLabel:
            id: issue_label
            node: root
            font_size: fm.tree_view_issue_label_font_size
            color: root.ISSUE_LABEL_COLOR
            background_color: root.ROW_BACKGROUND_COLOR
            markup: True
            mipmap: True
            size_hint: (None, None)
            width: root.ISSUE_LABEL_WIDTH
            height: root.ROW_HEIGHT
            halign: "left"
            valign: "middle"
            text_size: (self.width, self.height)
