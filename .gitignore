# Claude Code. Local by default (settings, installed third-party skills), except
# the verify skill, which documents this repo's own GUI test harness and so
# belongs with the code it drives. Git will not descend into an excluded
# directory, so each parent level has to be re-included for the negation to work.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/verify/

# Project-specific
build/
# Intermediate PDFs from scripts/generate_how_to_pdfs.py and generate_intro_pdf.py
# (fed into GIMP).
docs/how-to-pdfs/
docs/intro-pdf/
# Standalone executables produced by scripts/build.sh (Nuitka output:
# onefile binaries on Linux/Windows, zipped .app bundles on macOS).
/barks-reader-linux
/barks-reader-macos
/barks-reader-macos-x64
/barks-reader-macos.zip
/barks-reader-macos-x64.zip
/barks-reader-win.exe
src/barks-reader/src/barks_reader/_version.py
src/comic-utils/src/comic_utils/get_panel_bytes.py
src/comic-utils/src/comic_utils/get_panel_bytes.pyx
src/comic-utils/src/comic_utils/get_panel_bytes.pyx.template
src/comic-utils/src/comic_utils/get_panel_bytes.c
src/comic-utils/src/comic_utils/get_panel_bytes*.so
src/comic-utils/src/comic_utils/get_panel_bytes*.pyd
.benchmarks/
.venv/
logs/
.env.runtime
.coverage

# Python
__pycache__/

# PyCharm / IntelliJ
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf
.idea/**/aws.xml
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml
.idea/**/libraries
.idea/**/sonarlint/
.idea/$CACHE_FILE$
.idea/httpRequests
.idea/caches/build_file_checksums.ser
*.iws
graphify-out/

# mutmut mutation-testing workspace
mutants/
.mutmut-cache
mutmut-stats.json
/src/barks-reader/setup.cfg
/coverage.xml
/.hypothesis/
